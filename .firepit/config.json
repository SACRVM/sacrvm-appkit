{
  // Firepit per-project config. JSONC: comments and trailing commas are allowed.
  // Commands follow the Linux patterns of ../firepit-template/.firepit/config.json:
  // a group per area, a short lowercase name, a one-line description.

  "version": 1,
  "id": "sacrvm-appkit",

  "commands": [
    {
      "group": "Run",
      "name": "site",
      "description": "Serves the kit, style guide and demos on port 3000 (also reachable from a phone on the LAN).",
      "type": "shell",
      "command": "python3",
      "args": ["-m", "http.server", "3000"],
      "window": "reuse:site",
      "longRunning": true
    },

    {
      "group": "Open",
      "name": "styleguide",
      "description": "The style guide on the local server.",
      "type": "url",
      "url": "http://localhost:3000/#/styleguide"
    },
    {
      "group": "Open",
      "name": "demo",
      "description": "The Orb Lab demo app on the local server.",
      "type": "url",
      "url": "http://localhost:3000/#/orb-lab"
    },
    {
      "group": "Open",
      "name": "roadmap",
      "description": "The roadmap on the local server.",
      "type": "url",
      "url": "http://localhost:3000/#/roadmap"
    },
    {
      "group": "Open",
      "name": "build",
      "description": "The Build an App guide on the local server.",
      "type": "url",
      "url": "http://localhost:3000/#/build"
    },

    {
      "group": "Git",
      "name": "repo",
      "description": "The repository on GitHub.",
      "type": "url",
      "url": "https://github.com/SACRVM/sacrvm-appkit"
    }
  ]
}
